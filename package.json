{
  "name": "taptospell",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build:client && wrangler dev",
    "build:client": "esbuild src/client.tsx --bundle --format=esm --minify --outfile=public/app.js",
    "build": "npm run build:client",
    "start": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply taptospell --local",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:words": "tsx scripts/validate-words.ts",
    "validate:levels": "tsx scripts/validate-levels.ts",
    "validate:sounds": "tsx scripts/validate-sounds.ts",
    "generate:images": "tsx scripts/generate-images.ts"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.114.0",
    "@tanstack/react-start": "^1.114.0",
    "canvas-confetti": "^1.9.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.7.0",
    "@cloudflare/workers-types": "^4.20250214.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "~3.0.5",
    "wrangler": "^3.109.0"
  }
}
